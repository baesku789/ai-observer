{
  "manifest_version": 3,
  "name": "AI Observer — ChatGPT Discovery",
  "description": "ChatGPT 화면에서 질문, 답변, 링크와 DOM 증거를 사용자의 명시적 조작으로 수집합니다.",
  "version": "0.7.0",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "downloads", "sidePanel", "storage", "webRequest"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Observer 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
