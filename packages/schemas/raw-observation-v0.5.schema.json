{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-observer.local/schemas/raw-observation-v0.5.schema.json",
  "title": "AI Observer Raw Observation v0.5",
  "type": "object",
  "required": ["schema_version", "observation_id", "run_id", "surface", "measurement", "conversation_instances", "turn_candidates", "collector"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.5\\." },
    "measurement": {
      "type": "object",
      "required": ["measurement_type", "boundary_strategy"],
      "properties": {
        "measurement_type": { "enum": ["independent_query", "conversation_journey"] },
        "boundary_strategy": { "const": "user_confirmed" },
        "query_set": { "type": ["object", "null"] }
      }
    },
    "conversation_instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conversation_instance_id", "boundary_source", "query", "context_ids", "chat_modes"],
        "properties": {
          "conversation_instance_id": { "type": "string" },
          "query": {
            "type": ["object", "null"],
            "required": ["query_set_id", "query_id", "category", "repetition", "expected_prompt", "observed_prompt", "prompt_match"],
            "properties": {
              "query_set_id": { "type": "string" },
              "query_id": { "type": "string" },
              "category": { "type": "string" },
              "repetition": { "type": "integer", "minimum": 1 },
              "expected_prompt": { "type": "string" },
              "observed_prompt": { "type": ["string", "null"] },
              "prompt_match": { "enum": ["exact", "normalized", "mismatch", "unavailable"] }
            }
          }
        }
      }
    },
    "turn_candidates": { "type": "array" },
    "collector": { "type": "object", "required": ["name", "version"] }
  }
}
