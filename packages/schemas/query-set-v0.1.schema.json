{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-observer.local/schemas/query-set-v0.1.schema.json",
  "title": "AI Observer Query Set v0.1",
  "type": "object",
  "required": ["query_set_id", "queries"],
  "properties": {
    "query_set_id": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "null"] },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query_id", "text"],
        "properties": {
          "query_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    }
  }
}

