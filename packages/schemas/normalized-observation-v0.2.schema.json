{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-observer.local/schemas/normalized-observation-v0.2.schema.json",
  "title": "AI Observer Normalized Observation v0.2",
  "type": "object",
  "required": ["schema_version", "normalizer", "provenance", "measurement", "environment", "conversations", "turns", "sources", "source_summary", "normalization_warnings"],
  "properties": {
    "schema_version": { "const": "normalized-0.2.0" },
    "normalizer": { "type": "object", "required": ["name", "version"] },
    "provenance": { "type": "object", "required": ["raw_schema_version", "observation_id", "run_id"] },
    "measurement": { "type": "object", "required": ["measurement_type", "boundary_strategy"] },
    "environment": { "type": "object" },
    "conversations": { "type": "array", "items": { "$ref": "#/$defs/conversation" } },
    "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
    "sources": { "type": "array" },
    "source_summary": { "type": "object" },
    "normalization_warnings": { "type": "array" }
  },
  "$defs": {
    "conversation": {
      "type": "object",
      "required": ["conversation_instance_id", "boundary_source", "setup_chat_modes", "effective_chat_mode", "turn_chat_modes", "turn_ids", "turn_count"]
    },
    "turn": {
      "type": "object",
      "required": ["turn_id", "context_id", "conversation_instance_id", "chat_mode", "responses", "search_observation", "source_refs"]
    }
  }
}
